<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gnc_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for the safe terminal approach: a relative-motion plant and the preview MPC with the HOCBF-QP
    safety filter (python/gnc), running in deterministic lockstep.</description>
  <maintainer email="hasanbarangurbuz58@gmail.com">Hasan Baran Gurbuz</maintainer>
  <license>All rights reserved</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
